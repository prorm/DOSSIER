# ─── DOSSIER environment ────────────────────────────────────────────────
# Copy to .env and fill in. In production (NODE_ENV=production) the server
# refuses to start if any secret is missing, shorter than 32 chars, or equal
# to a known placeholder value.

# Postgres connection string. `pglite://.data/pglite` runs an embedded
# WASM Postgres (development / tests only, single process).
DATABASE_URL=postgres://dossier:dossier@localhost:5432/dossier

# Public base URL (used for QR codes, CSRF origin checks, cookies).
APP_URL=http://localhost:3000

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-session-secret-at-least-32-characters
ANSWER_SECRET=change-me-answer-secret-at-least-32-characters
TOKEN_SECRET=change-me-token-secret-at-least-32-characters

# Pack to import on boot (docker) / seed (pnpm db:seed). Folder under ./packs
ACTIVE_PACK=case-017

# Optional separate origin for the synthetic investigation sites (/x/<token>/…).
# Recommended in production so challenge-site cookies, storage and service
# workers never share an origin with the DOSSIER app. Point a second hostname
# at the same server, e.g. https://sandbox.example.edu. Empty = same origin.
SANDBOX_URL=

# Per-team SQL sandboxes (in-process PGlite worker threads, read-only).
SQL_SANDBOX_MAX=8
SQL_SANDBOX_TIMEOUT_MS=3000
# Per-team generated worlds kept in memory (LRU).
WORLD_CACHE_MAX=500

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# docker compose: host port for Postgres / app
DB_HOST_PORT=5432
APP_PORT=3000

# Control Room demo traffic (showcases only): demo teams keep playing through the real engine.
# Available when DEV_UI=true or DEMO_TRAFFIC=1. DEMO_TRAFFIC_SPARE names a team it never plays as.
# DEMO_TRAFFIC=1
# DEMO_TRAFFIC_SPARE=Null Pointers
